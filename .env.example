# ===================================================
# Movie Ticket Booking — Environment Variables
# ===================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ===================================================

# Database (SQL Server)
DB_PASSWORD=
DB_USERNAME=sa
DB_HOST=localhost
DB_PORT=1434

# Internal API Security (Feign inter-service auth)
INTERNAL_API_KEY=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017

# Eureka
EUREKA_URL=http://localhost:8761/eureka/
